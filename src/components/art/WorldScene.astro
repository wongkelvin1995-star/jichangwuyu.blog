---
export type WorldId = 'dream-town' | 'journey-railway' | 'crystal-market' | 'astral-observatory' | 'horizon-harbor' | 'mystic-forest' | 'device-atelier' | 'digital-dream-city' | 'everyday-story' | 'eternal-archives';

interface Props {
  world: WorldId;
  class?: string;
}

const { world, class: className = '' } = Astro.props;

const palettes: Record<WorldId, { top: string; mid: string; bot: string; accent: string }> = {
  'dream-town': { top: '#92C5E8', mid: '#DDA8BC', bot: '#F9F4EF', accent: '#D8B77E' },
  'journey-railway': { top: '#74609E', mid: '#92C5E8', bot: '#B6A7DF', accent: '#D8B77E' },
  'crystal-market': { top: '#39415D', mid: '#B6A7DF', bot: '#DDA8BC', accent: '#D8B77E' },
  'astral-observatory': { top: '#182238', mid: '#39415D', bot: '#92C5E8', accent: '#D8B77E' },
  'horizon-harbor': { top: '#92C5E8', mid: '#B6A7DF', bot: '#F9F4EF', accent: '#D8B77E' },
  'mystic-forest': { top: '#39415D', mid: '#74609E', bot: '#B6A7DF', accent: '#92C5E8' },
  'device-atelier': { top: '#182238', mid: '#74609E', bot: '#92C5E8', accent: '#D8B77E' },
  'digital-dream-city': { top: '#182238', mid: '#39415D', bot: '#74609E', accent: '#92C5E8' },
  'everyday-story': { top: '#DDA8BC', mid: '#F9F4EF', bot: '#92C5E8', accent: '#D8B77E' },
  'eternal-archives': { top: '#182238', mid: '#39415D', bot: '#74609E', accent: '#D8B77E' },
};

const p = palettes[world];
const uid = `world-${world}-${Math.random().toString(36).slice(2, 6)}`;
---

<svg
  class={`world-scene ${className}`}
  viewBox="0 0 640 240"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={p.top} />
      <stop offset="58%" stop-color={p.mid} />
      <stop offset="100%" stop-color={p.bot} />
    </linearGradient>
  </defs>

  <rect width="640" height="240" fill={`url(#${uid}-sky)`} />

  <!-- Distant Mountains -->
  <path d="M0,185 L95,125 L195,170 L315,112 L440,168 L545,122 L640,175 L640,240 L0,240 Z" fill="#39415D" opacity="0.28" />
  <path d="M0,205 L140,155 L260,192 L390,148 L520,188 L640,160 L640,240 L0,240 Z" fill="#182238" opacity="0.35" />

  <!-- Floating Stars -->
  <g class="fx-star" fill="#F9F4EF" opacity="0.85">
    <circle cx="88" cy="48" r="2.2" />
    <circle cx="196" cy="34" r="1.8" />
    <circle cx="342" cy="56" r="2.5" />
    <circle cx="486" cy="42" r="2" />
    <circle cx="574" cy="68" r="1.7" />
  </g>

  <!-- World-specific Silhouette Details -->
  {world === 'dream-town' && (
    <g fill="#39415D" opacity="0.72">
      <rect x="260" y="96" width="38" height="144" rx="2" />
      <polygon points="254,96 279,62 304,96" />
      <circle cx="279" cy="118" r="10" fill="#F9F4EF" stroke="#D8B77E" stroke-width="2" />
      <rect x="190" y="148" width="60" height="92" />
      <rect x="310" y="138" width="70" height="102" />
    </g>
  )}

  {world === 'journey-railway' && (
    <g>
      <line x1="0" y1="204" x2="640" y2="204" stroke="#D8B77E" stroke-width="3" opacity="0.7" />
      <g class="fx-railway" fill="#182238">
        <rect x="140" y="176" width="110" height="24" rx="5" stroke="#D8B77E" stroke-width="1.2" />
        <rect x="260" y="176" width="110" height="24" rx="5" stroke="#D8B77E" stroke-width="1.2" />
        <rect x="380" y="176" width="90" height="24" rx="5" stroke="#D8B77E" stroke-width="1.2" />
        <rect x="155" y="182" width="14" height="10" rx="2" fill="#F9F4EF" opacity="0.85" />
        <rect x="180" y="182" width="14" height="10" rx="2" fill="#F9F4EF" opacity="0.85" />
        <rect x="275" y="182" width="14" height="10" rx="2" fill="#F9F4EF" opacity="0.85" />
      </g>
    </g>
  )}

  {(world === 'crystal-market' || world === 'device-atelier') && (
    <g class="fx-crystal" fill={p.accent} opacity="0.78">
      <polygon points="150,140 168,180 150,210 132,180" />
      <polygon points="320,120 344,172 320,214 296,172" />
      <polygon points="490,144 508,182 490,212 472,182" />
    </g>
  )}

  {world === 'astral-observatory' && (
    <g fill="#182238" opacity="0.75">
      <path d="M270,240 L270,150 A50,50 0 0,1 370,150 L370,240 Z" />
      <line x1="336" y1="115" x2="392" y2="78" stroke="#D8B77E" stroke-width="6" stroke-linecap="round" />
    </g>
  )}

  {world === 'horizon-harbor' && (
    <g>
      <rect x="0" y="190" width="640" height="50" fill="#39415D" opacity="0.45" />
      <path d="M250,185 L340,185 L322,202 L264,202 Z" fill="#182238" />
      <polygon points="295,130 295,182 325,176" fill="#F9F4EF" opacity="0.85" />
    </g>
  )}

  {world === 'mystic-forest' && (
    <g fill="#182238" opacity="0.65" class="fx-wind">
      <polygon points="90,240 120,130 150,240" />
      <polygon points="190,240 228,110 266,240" />
      <polygon points="420,240 456,120 492,240" />
      <polygon points="510,240 545,140 580,240" />
    </g>
  )}

  {world === 'digital-dream-city' && (
    <g fill="#182238" opacity="0.72">
      <rect x="110" y="110" width="42" height="130" />
      <rect x="165" y="84" width="54" height="156" />
      <rect x="240" y="128" width="46" height="112" />
      <rect x="380" y="96" width="58" height="144" />
      <rect x="455" y="122" width="44" height="118" />
      <line x1="192" y1="96" x2="192" y2="210" stroke="#92C5E8" stroke-width="2" opacity="0.7" />
      <line x1="409" y1="110" x2="409" y2="220" stroke="#B6A7DF" stroke-width="2" opacity="0.7" />
    </g>
  )}

  {world === 'everyday-story' && (
    <g fill="#39415D" opacity="0.65">
      <rect x="240" y="142" width="160" height="98" rx="4" />
      <polygon points="225,142 320,96 415,142" />
      <rect x="296" y="168" width="48" height="36" rx="4" fill="#F9F4EF" opacity="0.88" />
    </g>
  )}

  {world === 'eternal-archives' && (
    <g>
      <circle cx="320" cy="110" r="48" fill="#F9F4EF" opacity="0.18" stroke="#D8B77E" stroke-width="2" />
      <line x1="80" y1="210" x2="560" y2="210" stroke="#D8B77E" stroke-width="2.5" />
      <circle cx="160" cy="210" r="5" fill="#D8B77E" />
      <circle cx="320" cy="210" r="6" fill="#D8B77E" />
      <circle cx="480" cy="210" r="5" fill="#D8B77E" />
    </g>
  )}
</svg>
