---
import YumeriaArt from '../art/YumeriaArt.astro';
import { brands, plans, coupons, serviceEvents } from '../../lib/db';

// Derived real views from unified database
const periodicMonthly = plans
  .filter((p) => p.category === 'periodic' && p.cycle === 'monthly')
  .sort((a, b) => a.price - b.price);

const budgetUnder20 = periodicMonthly.filter((p) => p.price <= 20).slice(0, 8);
const oneTimePacks = plans.filter((p) => p.category === 'dataPack').slice(0, 10);

// Lowest monthly starter per brand
const brandCards = brands.map((b) => {
  const monthlyPlans = plans.filter((p) => p.brandId === b.id && p.cycle === 'monthly');
  const minMonthly = monthlyPlans.length > 0 ? Math.min(...monthlyPlans.map((p) => p.price)) : null;
  const yearlySmall = b.planGroup?.yearlySmall?.[0] || null;
  return { ...b, minMonthly, yearlySmall };
});
---

