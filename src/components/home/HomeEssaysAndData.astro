            <tr>
              <td><a href={`/stories/${p.brandId}/`}>{p.brandName}</a></td>
              <td>{p.planName}</td>
              <td>一次性流量包</td>
              <td>¥{p.price}</td>
              <td>{p.trafficGb ? `${p.trafficGb} GB` : '见详情'}</td>
              <td>{p.pricePerGb ? `¥${p.pricePerGb}/GB` : '—'}</td>
              <td>{p.verifiedAt}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

