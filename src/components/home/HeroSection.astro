---
import YumeriaArt from '../art/YumeriaArt.astro';
import LumoArt from '../art/LumoArt.astro';
import WorldScene from '../art/WorldScene.astro';
import { getSiteStats } from '../../lib/db';

const stats = getSiteStats();
---

<section class="hero-section" id="module-01">
  <div class="hero-backdrop fx-layer" aria-hidden="true">
    <WorldScene world="dream-town" class="hero-world-bg" />
    <div class="hero-gradient-overlay"></div>
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="chapter-badge">MONOGATARI WORLD MAX · AIRPORT MONOGATARI</div>
      <div class="hero-brand-row">
        <span class="hero-brand-cn">机场物语</span>
        <span class="hero-brand-en">Every Connection Has a Story.</span>
      </div>

      <h1>机场物语：2027机场品牌研究、套餐对比与长期使用指南</h1>

      <p class="hero-slogan">每一次连接，都有属于自己的故事。</p>

      <p class="hero-intro">
        机场物语专注于机场品牌历史档案、真实套餐价格对比、历史优惠变化、续费与退款政策、线路协议百科及长期服务风险观察。
        2027年度指南基于截至 2026 年 11 月可核验的公开资料编写，坚持标注信息来源与证据边界，不虚构测速数据与用户评价。
      </p>

      <div class="hero-ctas">
        <a href="#module-02" class="btn btn-gold">开启物语之旅</a>
        <a href="/stories/" class="btn btn-primary">探索机场品牌档案</a>
        <a href="/plans/" class="btn btn-ghost">查看套餐价格研究</a>
        <a href="/observations/" class="btn btn-ghost">进入长期服务观察</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-stage story-card story-card--gold">
        <div class="stage-artwork-frame">
          <img
            src="/images/characters/yumeria-hero-stage.jpg"
            alt="YUMERIA · 梦璃与 LUMO · 星语精灵站在浪漫幻想小镇与海边列车高架桥前的夕阳插画"
            width="1200"
            height="900"
            fetchpriority="high"
            decoding="async"
            class="stage-hero-img"
          />
          <span class="lumo-badge">✦ YUMERIA · 梦璃 &amp; LUMO · 星语精灵</span>
        </div>
        <div class="stage-journal-note">
          <strong>YUMERIA · 梦璃（档案向导）</strong>
          <span>虚构幻想物语记录者 · 整理 18 家品牌历史与消费档案</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Real Database Dynamic Stats -->
  <div class="container hero-stats-wrap">
    <div class="hero-stats story-card">
      <div class="stat-item">
        <span class="stat-num">{stats.brandCount}</span>
        <span class="stat-label">已收录机场品牌</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{stats.planRecordCount}</span>
        <span class="stat-label">已整理套餐记录</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{stats.historicalPriceCount}</span>
        <span class="stat-label">历史价格索引条目</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{stats.verifiedEventCount}</span>
        <span class="stat-label">已核验服务事件</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{stats.articleCount}</span>
        <span class="stat-label">原创研究文章</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">{stats.toolCount}</span>
        <span class="stat-label">独家实用功能</span>
      </div>
      <div class="stat-item">
        <span class="stat-num" style="font-size:18px;">{stats.latestVerifiedDate}</span>
        <span class="stat-label">最新资料核验日期</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 42px 0 36px;
    overflow: hidden;
  }
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.24;
  }
  .hero-world-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(249, 244, 239, 0.35) 0%, var(--bg-page) 92%);
  }
  html[data-theme="night"] .hero-gradient-overlay {
    background: linear-gradient(180deg, rgba(18, 25, 43, 0.45) 0%, var(--bg-page) 92%);
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 32px;
    align-items: center;
  }
  .hero-brand-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
    margin: 14px 0 8px;
  }
  .hero-brand-cn {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--deep-dream);
  }
  html[data-theme="night"] .hero-brand-cn {
    color: var(--story-gold);
  }
  .hero-brand-en {
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .hero-copy h1 {
    font-size: clamp(26px, 3.6vw, 40px);
    margin: 0 0 12px;
    line-height: 1.25;
  }
  .hero-slogan {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--twilight-blue);
    margin: 0 0 12px;
  }
  html[data-theme="night"] .hero-slogan {
    color: var(--fantasy-sky);
  }
  .hero-intro {
    font-size: 15.5px;
    color: var(--text-secondary);
    margin: 0 0 22px;
    max-width: 620px;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-stage {
    position: relative;
    overflow: hidden;
    padding: 14px;
  }
  .stage-artwork-frame {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border-gold);
    background: #182238;
  }
  .stage-hero-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .lumo-badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(24, 34, 56, 0.78);
    backdrop-filter: blur(8px);
    color: #F9F4EF;
    border: 1px solid rgba(216, 183, 126, 0.55);
  }
  .stage-journal-note {
    position: relative;
    z-index: 1;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--border-gold);
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12.5px;
    text-align: center;
  }

  .hero-stats-wrap {
    position: relative;
    z-index: 1;
    margin-top: 28px;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 12px;
    padding: 18px 20px;
    text-align: center;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat-num {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--deep-dream);
  }
  html[data-theme="night"] .stat-num {
    color: var(--story-gold);
  }
  .stat-label {
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 540px) {
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
