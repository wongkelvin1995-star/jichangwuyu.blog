---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import YumeriaArt from '../../../components/art/YumeriaArt.astro';
import { brands, plans, serviceEvents, type BrandRecord } from '../../../lib/db';

export function getStaticPaths() {
  return brands.map((brand) => ({
    params: { brand: brand.slug },
    props: { brand },
  }));
}

interface Props {
  brand: BrandRecord;
}

const { brand } = Astro.props;
const brandPlans = plans.filter((p) => p.brandId === brand.id);
const brandEvents = serviceEvents.filter((e) => e.brandId === brand.id);
const periodic = brand.planGroup?.periodic || [];
const yearlySmall = brand.planGroup?.yearlySmall || [];
const dataPacks = brand.planGroup?.dataPacks || [];
const customPlans = brand.planGroup?.custom || [];
const relatedBrands = brands.filter((b) => b.slug !== brand.slug).slice(0, 4);
---

<BaseLayout
  title={`${brand.name}（${brand.nameEn}）品牌物语与套餐研究｜26节完整档案｜机场物语`}
  description={`${brand.name}完整品牌物语档案：${brand.tagline}。包含套餐价格、付款周期成本、流量倍率、客户端政策、历史资料、优缺点与消费风险提示。`}
  canonical={`https://jichangwuyu.blog${brand.storyPath}`}
  ogType="article"
  chapterTone="forest"
  publishedAt={brand.materialDate}
  updatedAt={brand.verifiedAt}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '品牌物语', url: '/stories/' },
    { name: brand.name, url: brand.storyPath },
  ]}
>
  <article class="container" style="padding:28px 0 48px;">
    <!-- 01. Brand Name & Crest -->
    <header class="story-card story-card--gold brand-hero">
      <div>
        <div class="chapter-badge">BRAND MONOGATARI #{String(brand.order).padStart(2, '0')} · 26节独立档案</div>
        <h1 style="margin:12px 0 6px;">{brand.name}（{brand.nameEn}）品牌物语档案</h1>
        <p style="font-size:16px;color:var(--text-secondary);margin:0 0 14px;">{brand.tagline}</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;">
          <span class="tag">核验日期：{brand.verifiedAt}</span>
          <span class="tag tag--gold">优惠码：{brand.coupon.code}</span>
          <span class="tag">历史索引：{brand.historicalRecordCount} 条（{brand.historicalPriceDate}）</span>
          <span class="tag">{brand.ratio}</span>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          <a href={brand.affiliateUrl} target="_blank" rel="noopener noreferrer sponsored" class="btn btn-gold">
            前往 {brand.name} 原始注册入口 ↗
          </a>
          <button type="button" class="btn btn-ghost bookmark-btn" data-slug={brand.slug}>
            ★ 收藏至我的物语
          </button>
          <a href={`/tools/value-analyzer/`} class="btn btn-ghost">用分析器核算成本</a>
        </div>
      </div>
      <YumeriaArt pose="recording" size={170} />
    </header>

    <div class="archive-sections">
      <!-- 02 & 03 -->
      <section class="story-card">
        <h2>02 · 品牌基础介绍 & 03 · 品牌服务定位</h2>
        <p>{brand.summary}</p>
        <p><strong>线路定位：</strong>{brand.lineTypes.join('；') || '以品牌公开说明为准'}</p>
        <p><strong>设备限制：</strong>{brand.deviceLimit}</p>
      </section>

      <!-- 04 -->
      <section class="story-card">
        <h2>04 · 品牌资料历史记录</h2>
        <p>
          截至 {brand.verifiedAt}，本站已归档来自《18家品牌资料总索引》的历史价格快照 {brand.historicalRecordCount} 条（快照日期：{brand.historicalPriceDate}），并结合 {brand.planGroup.source}（资料日期：{brand.materialDate}）完成结构化核对。未获取的早期成立年份与历史运营里程碑均不作虚构补全。
        </p>
      </section>

      <!-- 05, 06, 07, 08 -->
      <section class="story-card">
        <h2>05 · 完整套餐价格 & 07 · 不同付款周期成本分析</h2>
        {periodic.length > 0 ? (
          <div class="table-scroll" style="margin-top:12px;">
            <table>
              <thead>
                <tr>
                  <th>套餐名称</th>
                  <th>月流量</th>
                  <th>月付</th>
                  <th>季付</th>
                  <th>半年付</th>
                  <th>年付</th>
                  <th>年付折合月均</th>
                </tr>
              </thead>
              <tbody>
                {periodic.map((p) => (
                  <tr>
                    <td><strong>{p.plan}</strong></td>
                    <td>{p.trafficGb ? `${p.trafficGb} GB/月` : '见说明'}</td>
                    <td>{p.prices.monthly ? `¥${p.prices.monthly}` : '—'}</td>
                    <td>{p.prices.quarterly ? `¥${p.prices.quarterly}` : '—'}</td>
                    <td>{p.prices['half-year'] ? `¥${p.prices['half-year']}` : '—'}</td>
                    <td>{p.prices.yearly ? `¥${p.prices.yearly}` : '—'}</td>
                    <td>{p.prices.yearly ? `¥${(p.prices.yearly / 12).toFixed(2)}/月` : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p>暂无标准多周期公开表格记录，请参考以下专项档位或官网实时结算页。</p>
        )}

        {yearlySmall.length > 0 && (
          <div style="margin-top:16px;">
            <h3>年付小流量 / 专项周期套餐</h3>
            <ul class="clean-list">
              {yearlySmall.map((y) => (
                <li><strong>{y.plan}：</strong>¥{y.price}/年，{y.trafficGb ? `${y.trafficGb} GB/月` : ''}（{(y.notes || []).join('；')}）</li>
              ))}
            </ul>
          </div>
        )}

        {dataPacks.length > 0 && (
          <div style="margin-top:16px;">
            <h3>08 · 一次性流量套餐（不限时 / 流量包）</h3>
            <ul class="clean-list">
              {dataPacks.map((d) => (
                <li><strong>{d.plan}：</strong>¥{d.price} / {d.trafficGb} GB（约 ¥{(d.price / (d.trafficGb || 1)).toFixed(3)}/GB；{(d.notes || []).join('；') || '不限时流量包'}）</li>
              ))}
            </ul>
          </div>
        )}

        {customPlans.length > 0 && (
          <div style="margin-top:16px;">
            <h3>企业 / 独享定制档位</h3>
            <ul class="clean-list">
              {customPlans.map((c) => (
                <li><strong>{c.plan}：</strong>¥{c.price} / {c.trafficGb} GB（{(c.notes || []).join('；')}）</li>
              ))}
            </ul>
          </div>
        )}

        <h3 style="margin-top:18px;">06 · 历史套餐价格变化说明</h3>
        <p>
          目前拥有 {brand.historicalPriceDate} 公开索引快照（{brand.historicalRecordCount} 条）与 {brand.verifiedAt} 档案核验标价。因不同时期部分档位的流量额度与优惠口径存在差异，暂不绘制连续单线涨跌走势图，所有历史参照均保留原始来源链接。
        </p>
      </section>

      <!-- 09 & 10 -->
      <section class="story-card">
        <h2>09 · 流量倍率及重置规则 & 10 · 节点地区及线路</h2>
        <p><strong>流量倍率：</strong>{brand.ratio}</p>
        <ul class="clean-list">
          {brand.trafficRules.map((r) => <li>{r}</li>)}
        </ul>
        <p><strong>覆盖地区：</strong>{brand.regions.join('、')}（{brand.nodeCount ? `公开记录约 ${brand.nodeCount} 个节点` : '节点数量以官网最新列表为准'}）</p>
        {brand.nodeCountNote && <p style="font-size:13.5px;color:var(--text-muted);">{brand.nodeCountNote}</p>}
      </section>

      <!-- 11, 12, 13 -->
      <section class="story-card">
        <h2>11 · 客户端与订阅政策 · 12 · 设备兼容性 · 13 · AI与流媒体资料</h2>
        <ul class="clean-list">
          {brand.clientPolicy.map((c) => <li>{c}</li>)}
        </ul>
        <p><strong>流媒体声明：</strong>{brand.streaming.join(' / ') || '见官网说明'}</p>
        <p><strong>AI 工具声明：</strong>{brand.aiTools.join(' / ') || '见官网说明'}</p>
        <p style="font-size:13.5px;color:var(--text-muted);">{brand.streamingNote}</p>
      </section>

      <!-- 14, 15, 16 -->
      <section class="story-card">
        <h2>14 · 公开维护公告 · 15 · 服务政策变化时间轴 · 16 · 长期使用条件分析</h2>
        <div style="display:grid;gap:10px;margin:12px 0;">
          {brandEvents.map((e) => (
            <div style="padding:10px 14px;border-left:3px solid var(--story-gold);background:var(--bg-chapter-tint);border-radius:6px;">
              <strong>[{e.eventDate}] {e.title}</strong>
              <p style="margin:4px 0;font-size:14px;">{e.summary}</p>
              <small style="color:var(--text-muted);">证据：{e.evidenceType} · 状态：{e.verificationStatus}</small>
            </div>
          ))}
        </div>
        <p>
          长期使用建议先以月付周期验证本地晚高峰连接表现、客户端适配度与客服工单响应速度，再结合个人流量消耗决定是否切换季付或年付。
        </p>
      </section>

      <!-- 17, 18, 19 -->
      <section class="story-card">
        <h2>17 · 品牌优点 · 18 · 品牌不足与证据缺口 · 19 · 适合与不适合人群</h2>
        <h3>公开资料显示的亮点</h3>
        <ul class="clean-list">
          <li>线路与设备规则：{brand.lineTypes.join('；')}，{brand.deviceLimit}。</li>
          <li>优惠支持：记录优惠码 <code>{brand.coupon.code}</code>（{brand.coupon.discount || '以结算页为准'}）。</li>
        </ul>
        <h3>资料边界与潜在不足</h3>
        <ul class="clean-list">
          {(brand.conflicts.length > 0 ? brand.conflicts : ['部分早期历史价格、实时测速与售后细则需以官网最新条款为准。']).map((c) => <li>{c}</li>)}
          {brand.caveats.map((c) => <li>{c}</li>)}
        </ul>
        <h3>参考适用人群</h3>
        <ul class="clean-list">
          {brand.audiences.map((a) => <li>{a}</li>)}
        </ul>
      </section>

      <!-- 20, 21, 22, 23 -->
      <section class="story-card">
        <h2>20 · 退款续费政策 · 21 · 优惠码限制 · 22 · 原始AFF入口 · 23 · 消费风险提示</h2>
        <p><strong>退款与售后：</strong>虚拟网络订阅通常在激活或产生流量后不支持无理由退款，购买前请务必确认官网服务条款与工单渠道。</p>
        <p><strong>优惠码：</strong><code>{brand.coupon.code}</code>（{brand.coupon.evidenceNature}）。{brand.coupon.note || ''} {brand.coupon.excludes?.length ? `不适用档位：${brand.coupon.excludes.join('、')}。` : ''}</p>
        <p><strong>推广关系披露：</strong>下方注册入口保留用户提供的原始推广链接并标注 <code>rel="sponsored"</code>，不代表本站承诺其长期速度或永久稳定性。</p>
        <p>
          <a href={brand.affiliateUrl} target="_blank" rel="noopener noreferrer sponsored" class="btn btn-gold">
            访问 {brand.name} 原始注册链接 ↗
          </a>
        </p>
      </section>

      <!-- 24, 25, 26 -->
      <section class="story-card">
        <h2>24 · 历史资料来源 · 25 · 最新核验与更正 · 26 · 梦璃物语总结</h2>
        <ul class="clean-list">
          <li>
            原始品牌资料：
            {brand.sources
              .map((s: any) => (typeof s === 'string' ? s : `${s.note || s.file || '公开档案'}${s.date ? `（${s.date}）` : ''}`))
              .join('；')}
          </li>
          <li>历史价格索引来源：<a href={brand.priceSourceUrl} target="_blank" rel="noopener noreferrer">{brand.priceSourceUrl}</a></li>
          <li>最近核验日期：{brand.verifiedAt}（<a href="/contact/">提交更正建议</a>）</li>
        </ul>
        <div style="margin-top:14px;padding:14px;border-radius:10px;background:var(--bg-chapter-tint);border:1px solid var(--border-gold);">
          <strong>梦璃的物语笔记：</strong>
          {brand.name} 在公开档案中共记录了 {brandPlans.length} 项不同周期与流量组合。建议旅行者根据自身每月实际流量与设备数量，先用 <a href="/tools/value-analyzer/">套餐消费分析器</a> 核对每 GB 实际支出，并在 <a href="/tools/subscription-calendar/">个人订阅手账</a> 中记录到期日。
        </div>

        <div style="margin-top:18px;">
          <h3>继续阅读其他品牌物语</h3>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
            {relatedBrands.map((rb) => (
              <a href={rb.storyPath} class="tag">{rb.name}</a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </article>

  <script is:inline>
    (function () {
      var btn = document.querySelector('.bookmark-btn');
      if (!btn) return;
      var slug = btn.getAttribute('data-slug');
      var key = 'jichangwuyu_monogatari_profile_v1';
      function getP() {
        try { return JSON.parse(localStorage.getItem(key) || '{}'); } catch (e) { return {}; }
      }
      function render() {
        var p = getP();
        var list = Array.isArray(p.bookmarks) ? p.bookmarks : [];
        btn.textContent = list.indexOf(slug) >= 0 ? '★ 已收藏至我的物语' : '☆ 收藏至我的物语';
      }
      render();
      btn.addEventListener('click', function () {
        var p = getP();
        var list = Array.isArray(p.bookmarks) ? p.bookmarks : [];
        var idx = list.indexOf(slug);
        if (idx >= 0) list.splice(idx, 1); else list.push(slug);
        p.bookmarks = list;
        try { localStorage.setItem(key, JSON.stringify(p)); } catch (e) {}
        render();
      });
    })();
  </script>

  <style>
    .brand-hero {
      display: grid;
      grid-template-columns: 1fr 190px;
      gap: 24px;
      align-items: center;
      margin-bottom: 24px;
    }
    .archive-sections {
      display: grid;
      gap: 18px;
    }
    .archive-sections h2 {
      font-size: 20px;
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px dashed var(--border-subtle);
    }
    .archive-sections h3 {
      font-size: 16px;
      margin: 12px 0 6px;
    }
    .clean-list {
      padding-left: 18px;
      display: grid;
      gap: 6px;
      color: var(--text-secondary);
    }
    @media (max-width: 760px) {
      .brand-hero {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
